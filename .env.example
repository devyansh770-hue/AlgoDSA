# AlgoDSA Environment Variables Blueprint for Production
# Copy this file to .env locally or set these variables in your deployment dashboard (Render / Railway / VPS).

# ----------------------------------------------------
# 1. CORE DJANGO CONFIGURATION
# ----------------------------------------------------
DJANGO_SECRET_KEY=generate_a_random_50_character_secret_key_here
DEBUG=False
ALLOWED_HOSTS=algodsa.onrender.com,yourcustomdomain.com
CSRF_TRUSTED_ORIGINS=https://algodsa.onrender.com,https://yourcustomdomain.com

# ----------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL for Production)
# ----------------------------------------------------
# SQLite fallback used automatically if DATABASE_URL is not set.
DATABASE_URL=postgres://user:password@host:5432/dbname

# ----------------------------------------------------
# 3. AI MENTOR CONFIGURATION (Alex AI Engine)
# ----------------------------------------------------
AI_PROVIDER=openai   # Options: 'openai', 'anthropic', or 'mock'
OPENAI_API_KEY=sk-proj-your-openai-api-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
AI_MODEL=gpt-4o

# ----------------------------------------------------
# 4. CODE EXECUTION ENGINE (Judge0 API)
# ----------------------------------------------------
JUDGE0_MOCK=False
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your-rapidapi-judge0-key

# ----------------------------------------------------
# 5. SECURITY SWITCHES
# ----------------------------------------------------
SECURE_SSL_REDIRECT=True
